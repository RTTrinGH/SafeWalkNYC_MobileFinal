{
  "expo": {
    "name": "SafeWalk NYC",
    "slug": "safewalk-nyc",
    "scheme": "safewalknyc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.safewalknyc.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SafeWalk NYC uses your location to start routes from where you are and to guide you on your walk.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.safewalknyc.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fdf8f3"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafeWalk NYC uses your location to start routes from where you are and to guide you on your walk."
        }
      ],
      "expo-status-bar"
    ],
    "owner": "nebu1ad3v",
    "extra": {
      "eas": {
        "projectId": "c14e225d-6063-47d8-b7f0-a65a9bca44e3"
      }
    }
  }
}
